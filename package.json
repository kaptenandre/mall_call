  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "electron": "45.2.3",
    "mp4-muxer": "5.2.2"
  }
}
